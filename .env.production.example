# MODELO PENDENTE DE DADOS DO ALOJAMENTO. Não executar sem substituir os caminhos.
# Nunca publicar este ficheiro nem o .env na raiz pública. Nunca usar VITE_* para segredos.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=https://recrutamento.protege.org.mz
# Obter a raiz pública real junto do alojamento. Estes caminhos são apenas exemplos.
PUBLIC_ROOT=/home/CPANEL_USER/public_html/recrutamento
UPLOAD_TEMP_DIR=/home/CPANEL_USER/private/protege/uploads
DEDUP_DIR=/home/CPANEL_USER/private/protege/dedup
# Manter fechado. Política não aprovada por este modelo.
APPLICATIONS_ENABLED=false
PRIVACY_APPROVED=false
PRIVACY_POLICY_VERSION=
PRIVACY_POLICY_TEXT=
# Gerar localmente um segredo estável; não o incluir no repositório nem nos logs.
APPLICATION_SECRET=
TRUSTED_PROXIES=
APPLICATION_DEADLINE_AT=2026-11-21T00:00:00+02:00
JOB_DEADLINES_JSON={}
MAX_FILE_BYTES=5242880
MAX_TOTAL_BYTES=15728640
MAX_CERTIFICATES=5
DEDUP_TTL_HOURS=24
MIN_FORM_SECONDS=3
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
# A confirmar com o fornecedor. Não utilizar credenciais reais nesta fase.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_MAX_MESSAGE_BYTES=
