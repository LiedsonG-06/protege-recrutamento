NODE_ENV=development
# Em produção, raiz pública real do subdomínio (caminho absoluto).
PUBLIC_ROOT=
# Copiar para .env. Nunca colocar credenciais em variáveis VITE_*.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
# IPs/CIDRs exactos do proxy autorizado. Vazio = não confiar em X-Forwarded-For.
TRUSTED_PROXIES=
APPLICATIONS_ENABLED=false
PRIVACY_APPROVED=false
PRIVACY_POLICY_VERSION=
# Texto completo aprovado: finalidade, destinatários, retenção, direitos e contactos.
PRIVACY_POLICY_TEXT=
# Gerar localmente: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPLICATION_SECRET=
# Hipótese herdada, a confirmar pela PROTEGE; offset de Maputo obrigatório.
APPLICATION_DEADLINE_AT=2026-11-21T00:00:00+02:00
# Exemplo: {"campo":"2026-11-21T00:00:00+02:00"}
JOB_DEADLINES_JSON={}
MAX_FILE_BYTES=5242880
MAX_TOTAL_BYTES=15728640
MAX_CERTIFICATES=5
# Caminhos absolutos PRIVADOS fora da raiz pública do alojamento. Vazio usa temporários do SO.
UPLOAD_TEMP_DIR=
DEDUP_DIR=./.runtime/dedup
DEDUP_TTL_HOURS=24
MIN_FORM_SECONDS=3
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Endereço simples de remetente autorizado pelo serviço SMTP.
SMTP_FROM=

# Tamanho máximo da mensagem MIME confirmado pelo fornecedor (bytes); obrigatório com SMTP em produção.
SMTP_MAX_MESSAGE_BYTES=
